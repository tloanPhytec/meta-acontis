From 84e20a529c0ac135a937afe90be349781705bd7e Mon Sep 17 00:00:00 2001
From: tloan <tloan@phytec.com>
Date: Wed, 23 Sep 2026 18:04:47 +0000
Subject: [PATCH] pollux: dtso: add atemsys device tree overlay

Enables an optmized FEC ethernet driver on the phyBOARD-Pollux FEC Ethernet inteface for EtherCAT Master functionality.

Signed-off-by: tloan <tloan@phytec.com>
---
 arch/arm64/boot/dts/freescale/Makefile           |  2 ++
 .../imx8mp-phyboard-pollux-atemsys.dtso          | 16 ++++++++++++++++
 2 files changed, 18 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-atemsys.dtso

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 89183c1eb27c..08d825d54b4a 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -172,6 +172,7 @@ imx8mp-phyboard-pollux-vm020-csi2-fpdlink-port0-dtbs += imx8mp-phyboard-pollux-r
 			  imx8mp-phyboard-pollux-vm020-csi2-fpdlink-port0.dtbo
 imx8mp-phyboard-pollux-vm020-csi2-fpdlink-port1-dtbs += imx8mp-phyboard-pollux-rdk.dtb \
 			  imx8mp-phyboard-pollux-vm020-csi2-fpdlink-port1.dtbo
+imx8mp-phyboard-pollux-atemsys-dtbs += imx8mp-phyboard-pollux-rdk.dtb imx8mp-phyboard-pollux-atemsys.dtbo
 
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-isi-csi1.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-isi-csi2.dtb
@@ -201,6 +202,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-vm020-csi1-fpdlink-port1.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-vm020-csi2.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-vm020-csi2-fpdlink-port0.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-vm020-csi2-fpdlink-port1.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-atemsys.dtbo
 
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-ab2.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-navq.dtb imx8mp-navq-ov5640-ov5645.dts imx8mp-navq-ov5647-ov5640.dts
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-atemsys.dtso b/arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-atemsys.dtso
new file mode 100644
index 000000000000..102ffb48aaef
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-atemsys.dtso
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2026 PHYTEC America LLC
+ * Author: True Loan <tloan@phytec.com>
+ */
+
+/dts-v1/;
+/plugin/;
+
+&fec {
+    compatible = "atemsys";
+    atemsys-Ident = "FslFec";
+    atemsys-Instance = <1>;
+    status = "okay";
+};
+
-- 
2.34.1

