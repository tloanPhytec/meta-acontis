From f4bc2c7bf873d80bc26305be0303f02b62863d14 Mon Sep 17 00:00:00 2001
From: tloan <tloan@phytec.com>
Date: Fri, 4 Sep 2026 19:02:22 +0000
Subject: [PATCH] izar: dtso: add atemsys device tree overlay

- enables an optomized CPSW ethernet driver on the phyBOARD-Izar's MCU_ETH interface for EtherCAT Master functionality.

Signed-off-by: tloan <tloan@phytec.com>
---
 arch/arm64/boot/dts/ti/Makefile                    |  1 +
 .../boot/dts/ti/k3-am68-phyboard-izar-atemsys.dtso | 14 ++++++++++++++
 2 files changed, 15 insertions(+)
 create mode 100644 arch/arm64/boot/dts/ti/k3-am68-phyboard-izar-atemsys.dtso

diff --git a/arch/arm64/boot/dts/ti/Makefile b/arch/arm64/boot/dts/ti/Makefile
index ae12481637f0..6d1e09d304ec 100644
--- a/arch/arm64/boot/dts/ti/Makefile
+++ b/arch/arm64/boot/dts/ti/Makefile
@@ -127,6 +127,7 @@ dtb-$(CONFIG_ARCH_K3) += k3-am68-phyboard-izar-vm017-mipi-csi0.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am68-phyboard-izar-vm017-mipi-csi1.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am68-phyboard-izar-vm020-mipi-csi0.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am68-phyboard-izar-vm020-mipi-csi1.dtbo
+dtb-$(CONFIG_ARCH_K3) += k3-am68-phyboard-izar-atemsys.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am68-sk-base-board.dtb
 dtb-$(CONFIG_ARCH_K3) += k3-am68-sk-bb-csi2-ov5640.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am68-sk-bb-rpi-cam-imx219.dtbo
diff --git a/arch/arm64/boot/dts/ti/k3-am68-phyboard-izar-atemsys.dtso b/arch/arm64/boot/dts/ti/k3-am68-phyboard-izar-atemsys.dtso
new file mode 100644
index 000000000000..914529a5d53c
--- /dev/null
+++ b/arch/arm64/boot/dts/ti/k3-am68-phyboard-izar-atemsys.dtso
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2023 PHYTEC Messtechnik GmbH
+ * Author: True Loan <tloan@phytec.com>
+ */
+
+/dts-v1/;
+/plugin/;
+
+&mcu_cpsw {
+	compatible = "atemsys";
+	atemsys-Ident = "CPSWG";
+	atemsys-Instance = <1>;
+};
-- 
